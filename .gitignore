# Environment / secrets
.env
.env.*
!.env.example

# Go build outputs
/bin/
/build/
/dist/
*.exe
*.dll
*.so
*.dylib

# Go test cache
/coverage.out
/coverage.txt
/.cache/

# Go modules cache (usually not needed in repo)
