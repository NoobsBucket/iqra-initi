/vendor/

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
/logs/

# Temporary files
/tmp/
*.tmp

# Local database / runtime state
*.sqlite
*.db

# Node / frontend artifacts if ever added
node_modules/
